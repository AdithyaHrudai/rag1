# Copy this file to .env and fill in your own values. Never commit .env.
# Free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: override the Gemini chat model (must support tool calling)
# LLM_MODEL=gemini-2.5-flash

# Optional: override the local embedding model (FastEmbed; changing it rebuilds the index)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: User-Agent sent when fetching web pages and Wikipedia
# USER_AGENT=rag1-agentic-rag/0.1 (https://github.com/AdithyaHrudai/rag1)
